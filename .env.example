# Cổng public của Docker (ánh xạ vào cổng 8080 trong container).
PORT=8080

# Cho phép tạo tài khoản mới. Đặt false nếu server chỉ dành cho tài khoản đã tạo.
ALLOW_REGISTRATION=true

# Số ngày session còn hiệu lực.
SESSION_TTL_DAYS=30

# Kích thước tối đa của vault đã mã hóa, tính bằng byte.
MAX_VAULT_BYTES=5242880

# Đặt thành 1 khi chạy sau reverse proxy tin cậy (Caddy/Nginx) để rate limit đọc IP thật.
TRUST_PROXY=0
